{
	"name": "@repo/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./schema": {
			"types": "./src/schema.ts",
			"import": "./src/schema.ts"
		},
		"./store": {
			"types": "./src/store.ts",
			"import": "./src/store.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "bun run src/migrate.ts",
		"db:seed": "bun run src/seed.ts"
	},
	"dependencies": {
		"@repo/core": "workspace:*",
		"drizzle-orm": "^0.44.3",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"drizzle-kit": "^0.31.4",
		"typescript": "5.8.3"
	}
}
