{
  "name": "@engram/benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "Benchmark framework for SuperMemory performance testing",
  "scripts": {
    "bench:baseline": "tsx src/runner.ts --mode=baseline",
    "bench:optimized": "tsx src/runner.ts --mode=optimized",
    "bench:edge": "tsx src/runner.ts --mode=edge",
    "bench:compare": "tsx src/runner.ts --mode=compare",
    "bench:report": "tsx src/report.ts",
    "bench:ci-gate": "npm run bench:baseline && npm run bench:edge && npm run bench:compare -- --ci"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "hdr-histogram-js": "^3.0.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
