LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Smaran (cross-session memory) — see README.md "Memory (Smaran)" section.
# Leave SMARAN_URL empty to run without memory (recall/save become no-ops).
SMARAN_URL=
SMARAN_API_KEY=
# Set to "false" to run this exact agent as a plain-LLM baseline for A/B
# comparison — no other code path changes. Defaults to true.
SMARAN_ENABLED=true
