{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smaran-mcp",
	"build": {
		"command": "bun run build:ui"
	},
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],

	"rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],

	// API_URL must point at your own Smaran API deployment (apps/api) — there
	// is no shared default. This local-dev value assumes apps/api is running
	// via `bun run dev` in another terminal. Override for production in your
	// own deployment (e.g. `wrangler deploy --var API_URL:https://...`).
	"vars": {
		"API_URL": "http://localhost:8787"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_SERVER",
				"class_name": "SmaranMCP"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SmaranMCP"]
		}
	],

	"observability": {
		"enabled": true
	}
}
