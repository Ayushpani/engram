# ─── Storage ──────────────────────────────────────────────────────────
# "memory"   — in-process store, no DB, data lost on restart. Great for
#              a first tour and for tests.
# "supabase" — Postgres+pgvector via Supabase. DATABASE_URL required.
STORE=memory

# Supabase pooled connection string (only used when STORE=supabase).
# Dashboard → Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=

PORT=8787
CORS_ORIGIN=*

# ─── Embedder ─────────────────────────────────────────────────────────
# "hash"   — deterministic no-network stub. Proves the pipeline.
# "openai" — any /v1/embeddings host (OpenAI, Groq, Together, Ollama, …).
EMBEDDER=hash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ─── Sandbox auth ─────────────────────────────────────────────────────
# Only used when STORE=memory. Persistent mode uses api_keys table.
SANDBOX_API_KEY=sk_local_dev
