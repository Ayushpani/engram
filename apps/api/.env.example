# Supabase connection strings — see project → Settings → Database.
# Use the *pooled* URL (aws-0-*.pooler.supabase.com:6543) for the runtime.
# Use the *direct* URL (db.*.supabase.co:5432) only for migrations.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

PORT=8787
CORS_ORIGIN=*

# Embedder: "hash" (no network, dev only) or "openai" (any /v1/embeddings host).
EMBEDDER=hash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small
